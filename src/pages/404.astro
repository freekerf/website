---
// GitHub Pages serves this for any missing path; it links to both home pages.
import Base from '../layouts/Base.astro';
import { localePath, t } from '../lib/i18n';

const base = import.meta.env.BASE_URL;
---

<Base locale="en" page="404/" alternates={false} title={t('en', 'meta.notfound.title')} description={t('en', 'notfound.text')}>
  <section class="section page-head">
    <div class="wrap">
      <h1>{t('en', 'notfound.title')}</h1>
      <p class="lead">{t('en', 'notfound.text')}</p>
      <p class="actions">
        <a class="btn btn-primary" href={localePath('en', '', base)}>{t('en', 'notfound.home')}</a>
        <a class="btn" href={localePath('pt-br', '', base)} lang="pt-BR">{t('pt-br', 'notfound.home')}</a>
      </p>
    </div>
  </section>
</Base>

---
// The horizontal logo from freekerf/design (public/brand, synced): the dark-background
// version in the dark theme, the light-background version in the light theme.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span class="logo">
  <img class="on-dark" src={`${base}/brand/freekerf-horizontal-dark.svg`} alt="FreeKerf" width="142" height="32" />
  <img class="on-light" src={`${base}/brand/freekerf-horizontal-light.svg`} alt="FreeKerf" width="142" height="32" />
</span>

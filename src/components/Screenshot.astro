---
// A screenshot of the app in both themes (generated by `npm run screenshots`,
// doc/features/screenshots.md): the light one when the system is light.
// Optimized to WebP at two widths by astro:assets.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Scene name: src/assets/screenshots/<scene>-{dark,light}.png. */
  scene: string;
  alt: string;
  /** Rendered width, for `sizes`. */
  sizes?: string;
  eager?: boolean;
}

const { scene, alt, sizes = '(min-width: 1180px) 1100px, 100vw', eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const src = (theme: string) => {
  const f = files[`../assets/screenshots/${scene}-${theme}.png`];
  if (!f) throw new Error(`missing screenshot ${scene}-${theme}.png (npm run screenshots)`);
  return f.default;
};
const dark = src('dark');
const widths = [Math.round(dark.width / 2), dark.width];
const [d, l] = await Promise.all(
  ['dark', 'light'].map((theme) => getImage({ src: src(theme), format: 'webp', widths, quality: 82 })),
);
---

<picture class="shot">
  <source media="(prefers-color-scheme: light)" srcset={l!.srcSet.attribute} sizes={sizes} type="image/webp" />
  <source srcset={d!.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={d!.src}
    alt={alt}
    width={dark.width}
    height={dark.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    data-scene={scene}
  />
</picture>
